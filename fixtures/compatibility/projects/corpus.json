{
  "schema_version": "franken-node/project-compat-corpus/v1",
  "description": "Hand-authored executable package-resolution scenarios; not third-party npm certification.",
  "cases": [
    {"id": "commonjs-relative-chain", "category": "commonjs", "description": "Resolve relative CommonJS imports across a three-file dependency chain.", "entry": "main.cjs", "files": {"main.cjs": "console.log(require('./lib/answer.js'));\n", "lib/answer.js": "module.exports = require('./base.js') + 2;\n", "lib/base.js": "module.exports = 40;\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "commonjs-cache-identity", "category": "commonjs", "description": "Repeated extensionless/explicit loads share the same export object.", "entry": "main.cjs", "files": {"main.cjs": "const a = require('./counter'); a.value++; const b = require('./counter.js'); console.log(a === b, b.value);\n", "counter.js": "module.exports = { value: 0 };\n"}, "expected": {"stdout": "true 1\n", "stderr": "", "exit_code": 0}},
    {"id": "commonjs-cycle-partial-exports", "category": "commonjs", "description": "A cycle observes already-published exports without reevaluating the module.", "entry": "main.cjs", "files": {"main.cjs": "const a = require('./a'); console.log(a.ready, a.seen);\n", "a.js": "exports.ready = 'a-start'; const b = require('./b'); exports.seen = b.seen; exports.ready = 'a-done';\n", "b.js": "const a = require('./a'); exports.seen = a.ready;\n"}, "expected": {"stdout": "a-done a-start\n", "stderr": "", "exit_code": 0}},
    {"id": "commonjs-json-cache", "category": "commonjs", "description": "JSON modules are parsed once and cached by resolved filename.", "entry": "main.cjs", "files": {"main.cjs": "const a = require('./config.json'); a.value++; const b = require('./config.json'); console.log(a === b, b.value);\n", "config.json": "{\"value\":7}\n"}, "expected": {"stdout": "true 8\n", "stderr": "", "exit_code": 0}},
    {"id": "commonjs-directory-main", "category": "package-resolution", "description": "A relative package directory resolves its package.json main.", "entry": "main.cjs", "files": {"main.cjs": "console.log(require('./pkg'));\n", "pkg/package.json": "{\"name\": \"fixture-directory\", \"version\": \"1.0.0\", \"main\": \"lib/index.cjs\"}\n", "pkg/lib/index.cjs": "module.exports = 42;\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "bare-package-main", "category": "package-resolution", "description": "A bare specifier resolves a captured node_modules package, not a registry install.", "entry": "main.cjs", "files": {"main.cjs": "console.log(require('fixture-answer'));\n", "node_modules/fixture-answer/package.json": "{\"name\": \"fixture-answer\", \"version\": \"1.0.0\", \"main\": \"lib/main.cjs\"}\n", "node_modules/fixture-answer/lib/main.cjs": "module.exports = require('./base') + 2;\n", "node_modules/fixture-answer/lib/base.js": "module.exports = 40;\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "nested-dependency-precedence", "category": "package-resolution", "description": "A package uses its nearest nested dependency rather than the project-level version.", "entry": "main.cjs", "files": {"main.cjs": "console.log(require('fixture-token'), require('fixture-consumer'));\n", "node_modules/fixture-token/package.json": "{\"name\": \"fixture-token\", \"version\": \"1.0.0\", \"main\": \"index.js\"}\n", "node_modules/fixture-token/index.js": "module.exports = 'root';\n", "node_modules/fixture-consumer/package.json": "{\"name\": \"fixture-consumer\", \"version\": \"1.0.0\", \"main\": \"index.js\"}\n", "node_modules/fixture-consumer/index.js": "module.exports = require('fixture-token');\n", "node_modules/fixture-consumer/node_modules/fixture-token/package.json": "{\"name\": \"fixture-token\", \"version\": \"2.0.0\", \"main\": \"index.js\"}\n", "node_modules/fixture-consumer/node_modules/fixture-token/index.js": "module.exports = 'nested';\n"}, "expected": {"stdout": "root nested\n", "stderr": "", "exit_code": 0}},
    {"id": "scoped-package-subpath", "category": "package-resolution", "description": "Scoped package exports resolve an explicit public subpath.", "entry": "main.cjs", "files": {"main.cjs": "console.log(require('@fixture/math/add')(20, 22));\n", "node_modules/@fixture/math/package.json": "{\"name\": \"@fixture/math\", \"version\": \"1.0.0\", \"exports\": {\"./add\": \"./lib/add.cjs\"}}\n", "node_modules/@fixture/math/lib/add.cjs": "module.exports = function(a, b) { return a + b; };\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "conditional-exports-require", "category": "package-resolution", "description": "CommonJS selects the require branch rather than import/default.", "entry": "main.cjs", "files": {"node_modules/fixture-dual/package.json": "{\"name\": \"fixture-dual\", \"version\": \"1.0.0\", \"exports\": {\".\": {\"import\": \"./import.mjs\", \"require\": \"./require.cjs\", \"default\": \"./fallback.cjs\"}}}\n", "node_modules/fixture-dual/import.mjs": "export default 'import';\n", "node_modules/fixture-dual/require.cjs": "module.exports = 'require';\n", "node_modules/fixture-dual/fallback.cjs": "module.exports = 'wrong-condition';\n", "main.cjs": "console.log(require('fixture-dual'));\n"}, "expected": {"stdout": "require\n", "stderr": "", "exit_code": 0}},
    {"id": "conditional-exports-import", "category": "package-resolution", "description": "ESM selects the import branch rather than require/default.", "entry": "main.mjs", "files": {"node_modules/fixture-dual/package.json": "{\"name\": \"fixture-dual\", \"version\": \"1.0.0\", \"exports\": {\".\": {\"import\": \"./import.mjs\", \"require\": \"./require.cjs\", \"default\": \"./fallback.cjs\"}}}\n", "node_modules/fixture-dual/import.mjs": "export default 'import';\n", "node_modules/fixture-dual/require.cjs": "module.exports = 'require';\n", "node_modules/fixture-dual/fallback.cjs": "module.exports = 'wrong-condition';\n", "main.mjs": "import value from 'fixture-dual'; console.log(value);\n"}, "expected": {"stdout": "import\n", "stderr": "", "exit_code": 0}},
    {"id": "esm-relative-linking", "category": "esm", "description": "ESM links named exports across relative module boundaries.", "entry": "main.mjs", "files": {"main.mjs": "import { base } from './lib/base.mjs'; import { add } from './lib/add.mjs'; console.log(add(base, 2));\n", "lib/base.mjs": "export const base = 40;\n", "lib/add.mjs": "export function add(a, b) { return a + b; }\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "esm-live-bindings", "category": "esm", "description": "An imported binding remains live after a function mutates its exporting module.", "entry": "main.mjs", "files": {"main.mjs": "import { value, increment } from './counter.mjs'; console.log(value); increment(); console.log(value);\n", "counter.mjs": "export let value = 1; export function increment() { value++; }\n"}, "expected": {"stdout": "1\n2\n", "stderr": "", "exit_code": 0}},
    {"id": "esm-reexport-chain", "category": "esm", "description": "A re-export forwards a named binding through a barrel module.", "entry": "main.mjs", "files": {"main.mjs": "import { answer } from './index.mjs'; console.log(answer);\n", "index.mjs": "export { value as answer } from './value.mjs';\n", "value.mjs": "export const value = 42;\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "package-type-module-js", "category": "esm", "description": "The nearest package type determines the goal for .js entrypoints and dependencies.", "entry": "main.js", "files": {"package.json": "{\"name\": \"fixture-module\", \"version\": \"1.0.0\", \"type\": \"module\"}\n", "main.js": "import { answer } from './lib.js'; console.log(answer);\n", "lib.js": "export const answer = 42;\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "package-self-reference", "category": "package-resolution", "description": "A named package resolves its own exported entry without node_modules.", "entry": "main.mjs", "files": {"package.json": "{\"name\": \"@fixture/self\", \"version\": \"1.0.0\", \"type\": \"module\", \"exports\": {\".\": \"./lib/index.js\"}}\n", "main.mjs": "import { answer } from '@fixture/self'; console.log(answer);\n", "lib/index.js": "export const answer = 42;\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "package-imports-map", "category": "package-resolution", "description": "A package-local hash import resolves through the imports map.", "entry": "main.mjs", "files": {"package.json": "{\"name\": \"fixture-imports\", \"version\": \"1.0.0\", \"type\": \"module\", \"imports\": {\"#answer\": \"./lib/answer.js\"}}\n", "main.mjs": "import { answer } from '#answer'; console.log(answer);\n", "lib/answer.js": "export const answer = 42;\n"}, "expected": {"stdout": "42\n", "stderr": "", "exit_code": 0}},
    {"id": "package-exports-encapsulation", "category": "package-resolution", "description": "An existing private file is not importable when the exports map excludes it.", "entry": "main.cjs", "files": {"main.cjs": "try { require('fixture-private/private.js'); console.log('unexpected access'); } catch (error) { console.log(error.code); }\n", "node_modules/fixture-private/package.json": "{\"name\": \"fixture-private\", \"version\": \"1.0.0\", \"exports\": {\".\": \"./public.js\"}}\n", "node_modules/fixture-private/public.js": "module.exports = 'public';\n", "node_modules/fixture-private/private.js": "module.exports = 'secret';\n"}, "expected": {"stdout": "ERR_PACKAGE_PATH_NOT_EXPORTED\n", "stderr": "", "exit_code": 0}},
    {"id": "builtin-through-dependency", "category": "builtin-integration", "description": "A user module loads node:path and exposes its result to the entrypoint.", "entry": "main.cjs", "files": {"main.cjs": "const join = require('./join'); console.log(join('a', 'b'));\n", "join.js": "const path = require('node:path'); module.exports = function(a, b) { return path.posix.join(a, b); };\n"}, "expected": {"stdout": "a/b\n", "stderr": "", "exit_code": 0}},
    {"id": "filesystem-json-roundtrip", "category": "filesystem-integration", "description": "A dependency reads an input file and writes an independently checked output file.", "entry": "main.cjs", "files": {"main.cjs": "require('./writer.cjs')(); console.log('wrote');\n", "writer.cjs": "const fs = require('node:fs'); module.exports = function() { const data = JSON.parse(fs.readFileSync('input.json', 'utf8')); fs.writeFileSync('result.json', JSON.stringify({answer: data.value * 2}) + '\\n'); };\n", "input.json": "{\"value\":21}\n"}, "expected": {"stdout": "wrote\n", "stderr": "", "exit_code": 0, "files": {"result.json": "{\"answer\":42}\n", "unexpected.txt": null}}}
  ]
}
